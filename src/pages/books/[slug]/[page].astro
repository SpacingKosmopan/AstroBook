---
import { getCollection } from "astro:content";
import { Marked } from "marked";
import "../../../styles/markdown_book.css";
import "../../../styles/global.css";

/**
 * Ta funkcja pobiera wszystkie książki z biblioteki i przerabia je na obiekt {params:{}, props:{}}.
 *
 * Params to identyfikacja książka/strona po ścieżce.
 * Props to cała zawartość książki: podział na strony (lewa i prawa), numeracja stron (pierwsza to okładka, więc widoczny numer 1 będą miały następne) itp.
 *
 * Ta nazwa jest **obowiązkowa**
 */
export async function getStaticPaths() {
  const books = await getCollection("books");

  return books.flatMap((book) => {
    if (book.body === undefined) {
      throw new Error(`Brak treści książki: ${book.id}`);
    }

    const pages = book.body.split(/^\s*---\s*$/m);
    const totalPages = Math.ceil(pages.length / 2);

    return Array.from({ length: totalPages }, (_, index) => {
      const currentPage = index + 1;

      return {
        params: {
          slug: book.id,
          page: currentPage.toString(),
        },
        props: {
          book,
          leftContent: pages[index * 2],
          rightContent: pages[index * 2 + 1] ?? null,
          currentPage,
          totalPages,
          leftPhysicalPage: index * 2,
          rightPhysicalPage: index * 2 + 1,
        },
      };
    });
  });
}

/**
 * Dane przekazane do książki < props="" />
 */
const {
  book,
  leftContent,
  rightContent,
  currentPage,
  totalPages,
  leftPhysicalPage,
  rightPhysicalPage,
} = Astro.props;

/**
 * Parametry linku ./?q=
 */
const { slug } = Astro.params;

const marked = new Marked();
const leftHtml = marked.parse(leftContent);
const rightHtml = rightContent ? marked.parse(rightContent) : null;

const prevPageUrl =
  currentPage > 1 ? `/books/${slug}/${currentPage - 1}` : null;

const nextPageUrl =
  currentPage < totalPages ? `/books/${slug}/${currentPage + 1}` : null;

/**
 * Ustalenie setu:
 * - pierwsza strona
 * - ostatnia strona
 * - obecna strona
 * - strona poprzednia
 * - strona nastepna
 */
const pageNumbers = Array.from(
  new Set(
    // nie pozwala na duplikaty. będać na drugiej - pierwsza i poprzednia to te same
    [1, totalPages, currentPage - 1, currentPage, currentPage + 1].filter(
      (page) => page >= 1 && page <= totalPages, // pozbycie się stron wychodzących poza zakres
    ),
  ),
).sort((a, b) => a - b);

/**
 * Przedmioty paginacji (wyżej wymienione) w formie liczby lub stringa "..." (międzystrony, do których obecnie nie można przejść)
 */
const paginationItems: (number | "...")[] = [];
for (const page of pageNumbers) {
  const previous = paginationItems[paginationItems.length - 1];

  if (typeof previous === "number" && page - previous > 1) {
    paginationItems.push("..."); // wstawienie międzystrony
  }

  paginationItems.push(page); // wstawienie stron i "..." do padinationItems
}
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{book.data.title} — str. {currentPage}</title>
    <script>
      import "../../../scripts/reader-controls";
    </script>
  </head>

  <body class="bg-slate-50 text-slate-800 antialiased">
    <div class="w-full max-w-none mx-auto px-1">
      <header class="reader-header">
        <a
          href="/"
          class="shrink-0 rounded border border-slate-300 bg-white
           px-3 py-1.5 text-sm text-slate-600
           hover:border-blue-400 hover:text-blue-600"
        >
          ← Powrót
        </a>

        <div class="min-w-0 flex-1">
          <h1 class="truncate text-base font-semibold text-slate-800">
            {book.data.title}
          </h1>

          {
            book.data.subtitle && (
              <p class="truncate text-sm text-slate-500">
                {book.data.subtitle}
              </p>
            )
          }
        </div>

        <div class="reader-toolbar" aria-label="Narzędzia czytnika">
          <div class="zoom-controls" aria-label="Powiększenie strony">
            <button type="button" id="zoom-out" aria-label="Pomniejsz">−</button
            >
            <output id="zoom-value" aria-live="polite">100%</output>
            <button type="button" id="zoom-in" aria-label="Powiększ">+</button>
            <button type="button" id="zoom-reset">Dopasuj</button>
          </div>

          <button type="button" id="reader-fullscreen"> ⛶ Pełny ekran </button>
        </div>

        <button
          class="reader-toc-trigger"
          id="toc-open"
          type="button"
          aria-expanded="false"
          aria-controls="reader-toc"
        >
          <span aria-hidden="true">☰</span>
          <span>Spis treści</span>
        </button>

        <div class="reader-toc-backdrop" id="toc-backdrop" hidden>
          <aside
            class="reader-toc-panel"
            id="reader-toc"
            role="dialog"
            aria-modal="true"
            aria-label="Spis treści"
          >
            <div class="reader-toc-header">
              <h2>Spis treści</h2>
              <button
                id="toc-close"
                type="button"
                aria-label="Zamknij spis treści"
              >
                ✕
              </button>
            </div>

            <nav aria-label="Rozdziały podręcznika">
              <ol class="reader-toc-list">
                {
                  (book.data.chaptersPages ?? []).map((chapter) => (
                    <li class="toc-chapter">
                      <a
                        href={`/books/${slug}/${chapter.page}`}
                        aria-current={
                          currentPage === chapter.page ? "page" : undefined
                        }
                      >
                        <span>{chapter.name}</span>
                        <span class="toc-page">{chapter.page}</span>
                      </a>

                      {(chapter.subchapters ?? []).map((subchapter) => (
                        <div class="toc-subchapter">
                          <a
                            href={`/books/${slug}/${subchapter.page}`}
                            aria-current={
                              currentPage === subchapter.page
                                ? "page"
                                : undefined
                            }
                          >
                            <span>{subchapter.name}</span>
                            <span class="toc-page">{subchapter.page}</span>
                          </a>
                        </div>
                      ))}
                    </li>
                  ))
                }
              </ol>
            </nav>
          </aside>
        </div>
      </header>

      <div class="reader-shell" id="reader-shell">
        <nav class="side-navigation" aria-label="Nawigacja po stronach">
          <!-- lewy przycisk po boku -->
          <a
            href={prevPageUrl ?? "#"}
            aria-label="Poprzednia rozkładówka"
            title="Poprzednia rozkładówka"
            class:list={[
              "side-navigation-button",
              !prevPageUrl && "is-disabled",
            ]}
            aria-disabled={!prevPageUrl ? "true" : undefined}
            tabindex={!prevPageUrl ? -1 : undefined}
          >
            <span aria-hidden="true">‹</span>
          </a>

          <!-- prawy przycisk po boku -->
          <a
            href={nextPageUrl ?? "#"}
            aria-label="Następna rozkładówka"
            title="Następna rozkładówka"
            class:list={[
              "side-navigation-button",
              !nextPageUrl && "is-disabled",
            ]}
            aria-disabled={!nextPageUrl ? "true" : undefined}
            tabindex={!nextPageUrl ? -1 : undefined}
          >
            <span aria-hidden="true">›</span>
          </a>
        </nav>

        <div class="reader-viewport" id="reader-viewport">
          <div class="book-canvas">
            <main class="book-spread">
              <article class="book-page prose prose-slate max-w-none">
                <div set:html={leftHtml} />
                <footer class="page-number left-page-number">
                  {leftPhysicalPage > 0 ? leftPhysicalPage : ""}
                </footer>
              </article>

              {
                rightHtml !== null ? (
                  <article class="book-page prose prose-slate max-w-none">
                    <div set:html={rightHtml} />
                    <footer class="page-number right-page-number">
                      {rightPhysicalPage > 0 ? rightPhysicalPage : ""}
                    </footer>
                  </article>
                ) : (
                  <article class="book-page book-page-empty">
                    <span class="page-number right-page-number">
                      {rightPhysicalPage}
                    </span>
                  </article>
                )
              }
            </main>
          </div>
        </div>
      </div>
    </div>
  </body>

  <style>
    .book-page:first-child {
      border-radius: 3px 0 0 3px;
    }

    .book-page:last-child {
      border-radius: 0 3px 3px 0;
    }

    .book-page :global(img) {
      max-width: 100%;
      height: auto;
    }

    .book-page :global(pre) {
      overflow-x: auto;
    }

    .left-page-number {
      left: 7mm;
      right: auto;
      text-align: left;
    }

    .right-page-number {
      right: 7mm;
      left: auto;
      text-align: right;
    }

    .reader-shell {
      position: relative;
      width: 100%;
      min-width: 0;
    }

    .side-navigation {
      position: absolute;
      inset: 0;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-inline: 0;
      pointer-events: none;
    }

    .side-navigation-button {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 76px;
      border: 1px solid rgb(148 163 184 / 25%);
      border-radius: 8px;
      background: rgb(255 255 255 / 88%);
      color: #475569;
      font-size: 42px;
      line-height: 1;
      text-decoration: none;
      box-shadow: 0 2px 10px rgb(15 23 42 / 7%);
      pointer-events: auto;
      transition:
        background-color 150ms ease,
        color 150ms ease,
        border-color 150ms ease;
    }

    .side-navigation-button:hover {
      background: #eff6ff;
      border-color: #93c5fd;
      color: #2563eb;
    }

    .side-navigation-button:focus-visible {
      outline: 2px solid #2563eb;
      outline-offset: 3px;
    }

    .side-navigation-button.is-disabled {
      opacity: 0.25;
      pointer-events: none;
    }

    .reader-header {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      margin-bottom: 8px;
    }

    .reader-header > div:nth-child(2) {
      flex: 1;
      min-width: 0;
    }

    .reader-header .reader-toolbar {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }
  </style>
</html>
