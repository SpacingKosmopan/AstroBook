---
import { getCollection, getEntry, render } from "astro:content";

import "tailwindcss/index.css";

export async function getStaticPaths() {
  const books = await getCollection("books");
  return books.map((book) => ({
    params: { slug: book.id },
  }));
}

const { slug } = Astro.params;
const book = await getEntry("books", slug);

if (!book) {
  return Astro.redirect("/404");
}

const { Content } = await render(book);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{book.data.title} - Multibook</title>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased">
    <div class="max-w-3xl mx-auto py-12 px-4">
      <a href="/" class="text-blue-600 hover:underline">← Powrót do listy</a>

      <header class="my-6">
        <h1 class="text-4xl font-black text-slate-900">{book.data.title}</h1>
        {
          book.data.subtitle && (
            <p class="text-xl text-slate-500">{book.data.subtitle}</p>
          )
        }
      </header>

      <main class="prose prose-slate mt-8">
        <Content />
      </main>
    </div>
  </body>
</html>
