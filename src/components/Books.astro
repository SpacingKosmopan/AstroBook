---
import "tailwindcss/index.css";
import BookCard from "../components/BookCard.astro";

import { getCollection } from "astro:content";
const books = await getCollection("books");
---

<div
  class="min-h-screen bg-slate-50 py-12 px-4 text-slate-800 font-sans antialiased"
>
  <div class="max-w-7xl mx-auto">
    <header
      class="mb-12 text-center md:text-left border-b border-slate-200 pb-6"
    >
      <h1 class="text-3xl font-black text-slate-900 tracking-tight uppercase">
        Multibook <span
          class="bg-linear-to-r from-blue-600 to-fuchsia-600 bg-clip-text text-transparent"
          >e-Space Era</span
        >
      </h1>
      <p class="text-slate-500 mt-1 font-medium">
        Cyfrowy system edukacyjny publikacji nowej generacji.
      </p>
    </header>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8"
    >
      {books.map((book) => <BookCard data={book} />)}
    </div>
  </div>
</div>
